{
  "name": "@lloyal-labs/sdk",
  "version": "4.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Backend-agnostic TypeScript SDK for the lloyal inference platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": { "node": ["dist/node.d.ts"] }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloyal-ai/hdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/lloyal-ai/hdk#readme",
  "bugs": {
    "url": "https://github.com/lloyal-ai/hdk/issues"
  },
  "keywords": [
    "llm",
    "inference",
    "branch",
    "kv-cache",
    "tree-search",
    "llama.cpp"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -b",
    "test:audio": "tsx --test test/audio-integration.ts",
    "test:images": "tsx --test test/image-integration.ts"
  },
  "files": [
    "dist/",
    "LICENSE",
    "LICENSE-FAQ.md"
  ],
  "devDependencies": {
    "@lloyal-labs/lloyal.node": "^3.2.0"
  },
  "peerDependencies": {
    "@lloyal-labs/lloyal.node": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@lloyal-labs/lloyal.node": { "optional": true }
  }
}
