{
  "name": "@lloyal-labs/ui",
  "version": "0.3.0",
  "engines": {
    "node": ">=24"
  },
  "description": "The view side of a harness: the projection provider and hooks over a bridge, the generic agent fold, and the prose and figure primitives",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fold": {
      "types": "./dist/fold.d.ts",
      "default": "./dist/fold.js"
    },
    "./pcm-worklet": "./dist/pcm-worklet.js",
    "./prose": {
      "types": "./dist/prose.d.ts",
      "default": "./dist/prose.js"
    },
    "./video-player": {
      "types": "./dist/video-player.d.ts",
      "default": "./dist/video-player.js"
    },
    "./video.css": "./video.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloyal-ai/hdk.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/lloyal-ai/hdk/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/lloyal-ai/hdk/issues"
  },
  "keywords": [
    "ui",
    "react",
    "harness",
    "projection",
    "markdown"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist/",
    "video.css",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lloyal-labs/binding": "^0.3.0",
    "@lloyal-labs/media": "^0.3.0",
    "@types/mdast": "^4.0.4",
    "@videojs/react": "^10.1.0",
    "katex": "^0.16.22",
    "marked": "^18.0.13",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-string": "^4.0.0",
    "mediabunny": "^1.61.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vfile-location": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  }
}
