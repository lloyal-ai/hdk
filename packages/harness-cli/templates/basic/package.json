{
  "name": "__NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "A vertical inference harness scaffolded by `harness.dev`.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "__NAME__": "bin/run.js"
  },
  "main": "out/main/main.js",
  "files": [
    "bin/",
    "dist/",
    "harness.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx targets/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.electron.json",
    "prestart": "tsc",
    "start": "node bin/run.js",
    "predev:desktop": "node bin/ensure-electron.js",
    "dev:desktop": "tsc && electron-vite dev",
    "prebuild:desktop": "node bin/ensure-electron.js",
    "build:desktop": "tsc && electron-vite build",
    "serve": "tsc && node bin/serve.js",
    "dev:web": "concurrently -k -n serve,web -c blue,magenta \"npm run serve\" \"vite --config targets/web/vite.web.config.ts\"",
    "dev:web:client": "vite --config targets/web/vite.web.config.ts",
    "build:web": "vite build --config targets/web/vite.web.config.ts"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@lloyal-labs/binding": "^0.1.0",
    "@lloyal-labs/host": "^0.1.0",
    "@lloyal-labs/lloyal-agents": "^3.4.0",
    "@lloyal-labs/lloyal.node": "^3.1.0",
    "@lloyal-labs/rig": "^3.8.0",
    "@lloyal-labs/sdk": "^3.0.3",
    "effection": "^4.0.2",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.0",
    "electron": "^42.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
